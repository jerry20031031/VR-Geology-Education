  m_Script: {fileID: 11500000, guid: 03edbaeb99a83784ba857f43e1e2f435, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  missonUI: {fileID: 0}
  answerDatas:
  - AnswerText: "A:\u9078\u9805\u4E09:\u97CB\u683C\u7D0D\u3002 \u572820\u4E16\u7D00\u521D\uFF0C\u5FB7\u570B\u79D1\u5B78\u5BB6\u97CB\u683C\u7D0D\u63D0\u51FA\u5927\u9678\u6F02\u79FB\u8AAA\uFF0C\u8A8D\u70BA\u5728\u5169\u5104\u591A\u5E74\u524D\uFF0C\u539F\u59CB\u5927\u9678\u53EA\u6709\u4E00\u584A\uFF0C\u540D\u70BA\u76E4\u53E4\u5927\u9678"
    image: {fileID: 0}
  - AnswerText: "A:\u9078\u9805\u4E00: \u5316\u77F3\u5206\u5E03\u3001\u76F8\u4F3C\u7684\u6D77\u5CB8\u7DDA\u3001\u76F8\u5C0D\u61C9\u7684\u5C71\u8108\u69CB\u9020\u3002\u97CB\u683C\u7D0D\u5229\u7528\u53E4\u751F\u7269\u3001\u5CA9\u5C64\u548C\u5730\u8CEA\u69CB\u9020\u7B49\u8B49\u64DA\uFF0C\u8B49\u660E\u4E86\u5927\u9678\u66FE\u7D93\u6F02\u79FB\u3002"
    image: {fileID: 0}
  - AnswerText: "A:\u9078\u9805\u4E09:\u4E2D\u6D0B\u810A\u3002 \u6D77\u65AF\u8A8D\u70BA\u5730\u51FD\u5167\u7684\u5CA9\u6F3F\u6CBF\u4E2D\u6D0B\u810A\u88C2\u8C37\u4E0A\u5347\uFF0C
      \u5728\u4E2D\u6D0B\u810A\u9802\u90E8\u5F62\u6210\u65B0\u7684\u6D77\u6D0B\u5730\u6BBC"
    image: {fileID: 0}
  - AnswerText: "A:\u9078\u9805\u4E00:\u5730\u78C1\u53CD\u8F49 \u4E2D\u6D0B\u810A\u5F80\u5169\u5074\u89C0\u5BDF\uFF0C\u6703\u770B\u5230\u4E0D\u540C\u5E74\u4EE3\u7684\u5CA9\u77F3
      \u8A18\u9304\u8457\u7576\u6642\u78C1\u5834\u7684\u65B9\u5411\u800C\u4E14\u5F7C\u6B64\u5C0D\u7A31\u3002\u6839\u64DA
      \u7D00\u9304\u986F\u793A\uFF0C\u5728\u6700\u8FD1\u7684450 \u842C\u5E74\u5167\uFF0C\u5730\u7403\u78C1\u5834
      \u5012\u8F49\u4E86\u4E5D\u6B21\u4E4B\u591A\u3002"
    image: {fileID: 0}
  - AnswerText: "A:\u9078\u9805\u4E00:\u6D77\u6D0B\u5730\u6BBC\u3002 \u5730\u51FD\u5167\u7684\u5CA9\u6F3F\u6CBF\u4E2D\u6D0B\u810A\u88C2\u8C37\u4E0A\u5347\uFF0C\u5728\u4E2D\u6D0B\u810A\u9802\u90E8\u5F62\u6210\u65B0\u7684\u6D77\u6D0B\u5730\u6BBC"
    image: {fileID: 0}
