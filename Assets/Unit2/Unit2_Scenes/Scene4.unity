    - target: {fileID: 8181089321788976988, guid: 817ee5dfd31a6b14e810c71e57b8af68,
        type: 3}
      propertyPath: textImageList.Array.data[1].text
      value: "\u6B61\u8FCE\u4F86\u5230\u6A21\u64EC\u677F\u584A\u79FB\u52D5\u7684\u5BE6\u9A57\u5BA4\uFF0C\u6211\u5011\u53EF\u4EE5\u5728\u9019\u88E1\u900F\u904E\u677F\u584A\u79FB\u52D5\u89C0\u5BDF\u5CA9\u6F3F\uFF0C\u70BA\u4E86\u5B89\u5168\u8D77\u898B\uFF0C\u4F60\u5FC5\u9808\u7AD9\u5728[\u85CD\u8272\u5713\u5708\u5149\u74B0]\u624D\u53EF\u4EE5\u958B\u59CB\u79FB\u52D5"
      objectReference: {fileID: 0}
    - target: {fileID: 8181089321788976988, guid: 817ee5dfd31a6b14e810c71e57b8af68,
        type: 3}
      propertyPath: textImageList.Array.data[2].text
      value: "\u9019\u662F\u4E00\u584A\u53EF\u5F80\u5DE6\u79FB\u52D5\u7684\u805A\u5408\u578B\u677F\u584A(\u7576\u624B\u628A\u5C04\u7DDA\u5448\u73FE\u85CD\u8272\u6309\u4E0B\u6309\u9215\u5373\u53EF\u62D6\u52D5)"
      objectReference: {fileID: 0}
