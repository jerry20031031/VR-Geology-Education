        type: 3}
      propertyPath: textImageList.Array.data[3].text
      value: "\u9019\u662F\u4E00\u584A\u53EF\u5F80\u53F3\u79FB\u52D5\u7684\u5F35\u88C2\u677F\u584A(\u7576\u624B\u628A\u5C04\u7DDA\u5448\u73FE\u85CD\u8272\u6309\u4E0B\u6309\u9215\u5373\u53EF\u62D6\u52D5)"
