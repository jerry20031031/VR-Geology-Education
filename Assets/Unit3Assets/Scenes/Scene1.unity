    title: "\u7409\u7403\u6D77\u6E9D"
    text: "\u7409\u7403\u6D77\u6E9D\u4F4D\u65BC\u53F0\u7063\u6771\u5317\u5916\u6D77\uFF0C\u662F\u6B50\u4E9E\u677F\u584A\u8207\u83F2\u5F8B\u8CD3\u6D77\u677F\u584A\u4E4B\u9593\u7684\u96B1\u6C92\u5E36\u3002\u9019\u689D\u6D77\u6E9D\u662F\u83F2\u5F8B\u8CD3\u6D77\u677F\u584A\u96B1\u6C92\u81F3\u6B50\u4E9E\u677F\u584A\u4E4B\u4E0B\u6240\u5F62\u6210\uFF0C\u4E26\u4E14\u8207\u7409\u7403\u5CF6\u5F27\u7684\u5F62\u6210\u6709\u95DC\u3002\u7409\u7403\u6D77\u6E9D\u7684\u5B58\u5728\u4FC3\u4F7F\u4E86\u8A72\u5730\u5340\u7684\u706B\u5C71\u6D3B\u52D5\u53CA\u5F37\u70C8\u7684\u5730\u9707\u73FE\u8C61\u3002 "
    image: {fileID: 21300000, guid: acc5dd6cff9a1104a85a0628d843f14c, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 14
    title: "\u99AC\u5C3C\u62C9\u6D77\u6E9D"
    text: "\u99AC\u5C3C\u62C9\u6D77\u6E9D\u4F4D\u65BC\u53F0\u7063\u897F\u5074\uFF0C\u5EF6\u4F38\u81F3\u83F2\u5F8B\u8CD3\u6D77\u57DF\uFF0C\u662F\u83F2\u5F8B\u8CD3\u6D77\u677F\u584A\u8207\u6B50\u4E9E\u677F\u584A\u4E4B\u9593\u7684\u96B1\u6C92\u5E36\u3002\u9019\u689D\u6D77\u6E9D\u662F\u83F2\u5F8B\u8CD3\u6D77\u677F\u584A\u5411\u897F\u96B1\u6C92\u81F3\u6B50\u4E9E\u677F\u584A\u4E4B\u4E0B\u7684\u7D50\u679C\uFF0C\u662F\u53F0\u7063\u5730\u5340\u5730\u9707\u6D3B\u8E8D\u5340\u4E4B\u4E00\uFF0C\u4E26\u4E14\u5C0D\u53F0\u7063\u7684\u5730\u9707\u6D3B\u52D5\u548C\u706B\u5C71\u6D3B\u52D5\u6709\u91CD\u8981\u5F71\u97FF\u3002 "
    image: {fileID: 21300000, guid: c14a88c83e45e4a44a796bbfea98362a, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 15
    title: "\u9020\u5C71\u4F5C\u7528"
    text: "\u9020\u5C71\u4F5C\u7528\u53EF\u767C\u751F\u5728\u677F\u584A\u78B0\u649E\u6642\uFF0C\u82E5\u4E00\u65B9\u7121\u6CD5\u5B8C\u5168\u96B1\u6C92\uFF0C\u6216\u539F\u672C\u7684\u96B1\u6C92\u5E36\u8F49\u8B8A\u70BA\u64E0\u58D3\u5340\uFF0C\u5247\u5730\u6BBC\u53D7\u5230\u63A8\u64E0\u62AC\u5347\uFF0C\u5F62\u6210\u5C71\u8108\u3002"
    image: {fileID: 21300000, guid: 6d73a60b088436d4f9867b34a9c87bf4, type: 3}
    relatedTaskName: "\u63A2\u67E5\u9020\u5C71\u4F5C\u7528\u6A21\u578B"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 16
    title: "\u96B1\u6C92\u4F5C\u7528"
    text: "\u96B1\u6C92\u4F5C\u7528\u767C\u751F\u65BC\u5BC6\u5EA6\u8F03\u5927\u7684\u6D77\u6D0B\u677F\u584A\u8207\u8F03\u8F15\u7684\u5927\u9678\u677F\u584A\u78B0\u649E\u6642\uFF0C\u6D77\u6D0B\u677F\u584A\u96B1\u6C92\u81F3\u5730\u5E54\uFF0C\u5F62\u6210\u6D77\u6E9D\u4E26\u90E8\u5206\u7194\u878D\uFF0C\u7522\u751F\u5CA9\u6F3F\uFF0C\u5CA9\u6F3F\u4E0A\u5347\u81F3\u5730\u8868\u5F62\u6210\u706B\u5C71\u5CF6\u5F27"
    image: {fileID: 21300000, guid: f902f88e7b4f2c1418ae291edd0798f0, type: 3}
    relatedTaskName: "\u63A2\u67E5\u96B1\u6C92\u4F5C\u7528\u6A21\u578B"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 17
    title: "P\u6CE2\uFF08Primary Wave\uFF09"
    text: "P\u6CE2\u662F\u5730\u9707\u767C\u751F\u5F8C\u6700\u5148\u5230\u9054\u7684\u6CE2\uFF0C\u4EE5\u58D3\u7E2E\u8207\u81A8\u8139\u7684\u65B9\u5F0F\u6CBF\u8457\u50B3\u64AD\u65B9\u5411\u9707\u52D5\uFF0C\u5C31\u50CF\u5F48\u7C27\u58D3\u7E2E\u8207\u4F38\u5C55\u4E00\u6A23\uFF0C\u53EF\u4EE5\u7A7F\u900F\u56FA\u9AD4\u3001\u6DB2\u9AD4\u548C\u6C23\u9AD4\u3002"
    image: {fileID: 21300000, guid: a1a8d7e3c61895141b616e4014f24689, type: 3}
    relatedTaskName: "\u63A2\u67E5\u96B1\u6C92\u4F5C\u7528\u6A21\u578B"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 18
    title: "S\u6CE2\uFF08Secondary Wave\uFF09"
    text: "S\u6CE2\u901F\u5EA6\u6BD4P\u6CE2\u6162\uFF0C\u5C6C\u65BC\u526A\u5207\u6CE2\uFF0C\u6703\u8B93\u5730\u9762\u4E0A\u4E0B\u6216\u5DE6\u53F3\u5782\u76F4\u65BC\u50B3\u64AD\u65B9\u5411\u6643\u52D5\uFF0C\u53EA\u80FD\u901A\u904E\u56FA\u9AD4\uFF0C\u7121\u6CD5\u7A7F\u8D8A\u6DB2\u9AD4\uFF0C\u56E0\u6B64\u5728\u5730\u7403\u5167\u90E8\u7684\u6DB2\u614B\u5916\u6838\u4E2D\u7121\u6CD5\u50B3\u64AD\u3002"
    image: {fileID: 21300000, guid: dff6c36eff389974e8f36caec9e012cc, type: 3}
    relatedTaskName: "\u63A2\u67E5\u96B1\u6C92\u4F5C\u7528\u6A21\u578B"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 19
    title: "\u6D1B\u592B\u6CE2\uFF08Love Wave\uFF09"
    text: "\u6D1B\u592B\u6CE2\u4E5F\u662F\u8868\u9762\u6CE2\uFF0C\u5B83\u4F7F\u5730\u9762\u6C34\u5E73\u5DE6\u53F3\u6416\u52D5\uFF08\u50CF\u86C7\u884C\uFF09\uFF0C\u50B3\u64AD\u901F\u5EA6\u5FEB\u4E14\u80FD\u91CF\u96C6\u4E2D\u5728\u5730\u8868\uFF0C\u5C0D\u5EFA\u7BC9\u7269\u7834\u58DE\u529B\u6975\u5F37\uFF0C\u5E38\u662F\u5730\u9707\u707D\u5BB3\u7684\u4E3B\u56E0\u4E4B\u4E00\u3002"
    image: {fileID: 21300000, guid: e3373f6ede2b4de45be33de475eee431, type: 3}
    relatedTaskName: "\u63A2\u67E5\u96B1\u6C92\u4F5C\u7528\u6A21\u578B"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 20
    title: "\u96F7\u5229\u6CE2\uFF08Rayleigh Wave\uFF09"
    text: "\u96F7\u5229\u6CE2\u662F\u4E00\u7A2E\u8868\u9762\u6CE2\uFF0C\u6703\u8B93\u5730\u9762\u4EE5\u6A62\u5713\u8ECC\u8DE1\u4E0A\u4E0B\u4E26\u524D\u5F8C\u6EFE\u52D5\uFF0C\u985E\u4F3C\u6D77\u6D6A\u5728\u5730\u9762\u6EFE\u52D5\u7684\u611F\u89BA\uFF0C\u5E38\u8B93\u4EBA\u611F\u53D7\u5230\u5982\u8239\u5728\u6416\u6643\u7684\u5730\u9707\u611F\u3002"
    image: {fileID: 21300000, guid: 6ce40e19ccb05894bbccefb3d4f44610, type: 3}
    relatedTaskName: "\u63A2\u67E5\u96B1\u6C92\u4F5C\u7528\u6A21\u578B"
