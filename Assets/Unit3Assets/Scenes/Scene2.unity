  m_Script: {fileID: 11500000, guid: 1e74b7edcf966a648ad9ea879a1e79f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textImageList:
  - id: 0
    title: "\u7121"
    text: "\u9EDE\u9078\u7269\u4EF6\u4EE5\u63D0\u4F9B\u65B0\u8CC7\u8A0A"
    image: {fileID: 0}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 1
    title: "\u53F0\u7063\u6A21\u578B"
    text: "\u4E00\u5EA7\u53F0\u7063\u6D77\u5E95\u6A21\u578B\uFF0C\u4F3C\u4E4E\u53EF\u4EE5\u5728\u4E0A\u9762\u505A\u4E9B\u4EC0\u9EBC 
      \u4F4D\u65BC\u6B50\u4E9E\u677F\u584A\u8DDF\u83F2\u5F8B\u8CD3\u6D77\u677F\u584A\u7684\u4EA4\u754C\u8655
      \u5C6C\u65BC\u805A\u5408\u578B\u677F\u584A\uFF0C\u9577\u5E74\u5730\u9707\u4E14\u6DF1\u6E90\u6DFA\u6E90\u90FD\u6709\uFF0C\u5468\u906D\u6709\u6D77\u6E9D\u53CA\u706B\u5C71\u5CF6\u5F27\u7684\u5730\u5F62\u7D50\u69CB"
    image: {fileID: 21300000, guid: d26a9c46daffa67429588d14e9267969, type: 3}
    relatedTaskName: "\u63A2\u67E5\u53F0\u7063\u6A21\u578B"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 2
    title: "\u5CF6\u5F27\u6A19\u8A8C"
    text: "\u4E00\u500B\u5CF6\u5F27\u7684\u6A19\u8A8C\uFF0C\u9EDE\u9078\u5F8C\u6703\u51FA\u73FE\u5CF6\u5F27\u7684\u8CC7\u8A0A\u4F46\u662F\u4E26\u4E0D\u9F4A\u5168\uFF0C\u800C\u4E14\u6703\u5728\u5E95\u4E0B\u51FA\u73FE\u602A\u7570\u7684\u63D0\u793A\u7C92\u5B50\uFF0C\u597D\u50CF\u9700\u8981\u88AB\u6572\u64CA\u624D\u80FD\u89E3\u9396\u3002 "
    image: {fileID: 21300000, guid: 244fca2cfcf94c14b9aaac16fc98aea0, type: 3}
    relatedTaskName: "\u63A2\u67E5\u6A19\u8A8C\u7269\u4EF6"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 3
    title: "\u5341\u5B57\u93AC"
    text: "\u4E00\u500B\u7C21\u55AE\u7684\u5341\u5B57\u7E1E\uFF0C\u770B\u8D77\u4F86\u6BEB\u7121\u91CD\u91CF\uFF0C\u4F3C\u4E4E\u662F\u89E3\u9396\u8CC7\u8A0A\u7684\u5DE5\u5177\u3002"
    image: {fileID: 21300000, guid: 10f77ff58deb7864e9e6ab08816e31d2, type: 3}
    relatedTaskName: "\u63A2\u67E5\u5341\u5B57\u93AC"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 4
    title: "\u5B78\u59CA"
    text: "\u5BE6\u9A57\u5BA4\u7684\u6838\u5FC3\u4EBA\u7269\uFF0C\u8010\u5FC3\u6307\u5C0E\u5F8C\u8F29\uFF0C\u7279\u5225\u64C5\u9577\u5F15\u5C0E\u5F8C\u8F29\u89E3\u6C7A\u554F\u984C\u3002\u4E0D\u50C5\u662F\u5B78\u8853\u4E0A\u7684\u699C\u6A23\uFF0C\u4E5F\u5728\u751F\u6D3B\u4E2D\u7D66\u4E88\u652F\u6301\u548C\u9F13\u52F5\uFF0C\u8B93\u5BE6\u9A57\u5BA4\u5145\u6EFF\u6EAB\u6696\u8207\u52D5\u529B\uFF0C\u662F\u5F88\u591A\u5B78\u5F1F\u59B9\u611B\u6155\u7684\u4EBA\u3002"
    image: {fileID: 21300000, guid: b018010a9b1e6c5418e6173282352d42, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 5
    title: "\u6559\u6388"
    text: "\u5BE6\u9A57\u5BA4\u7684\u51FA\u984C\u5C08\u5BB6\uFF0C\u7E3D\u80FD\u8A2D\u8A08\u51FA\u5BCC\u6709\u6311\u6230\u6027\u53C8\u555F\u767C\u601D\u8003\u7684\u554F\u984C\uFF0C\u5F15\u5C0E\u6211\u5011\u6DF1\u5165\u63A2\u7D22\u7814\u7A76\u8AB2\u984C\uFF0C\u64DA\u8AAA\u6C92\u6709\u4EBA\u770B\u904E\u6559\u6388\u8863\u670D\u6709\u8B8A\u904E\u3002 "
    image: {fileID: 21300000, guid: eb4987ddd906ac6418278fb1ad6efcfa, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 6
    title: "\u9707\u6E90\u5206\u5E03\u6A21\u578B"
    text: "\u8A18\u9304\u4E86\u53F0\u7063\u6B77\u5E74\u5730\u9707\u7684\u9707\u6E90\u5206\u5E03\uFF0C\u5C24\u5176\u5716\u4E2D\u8F03\u6DF1\u7684\u9707\u6E90\u5C31\u662F\u4F4D\u65BC\u677F\u584A\u4EA4\u754C\u8655\u7684\u5730\u65B9 "
    image: {fileID: 21300000, guid: bed53f1063a805e44b1727520fdced00, type: 3}
    relatedTaskName: "\u63A2\u67E5\u9707\u6E90\u5206\u5E03\u6A21\u578B"
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 7
    title: "\u706B\u5C71\u9310"
    text: "\u706B\u5C71\u9310\u662F\u7531\u706B\u5C71\u5674\u767C\u6240\u5806\u7A4D\u7684\u7194\u5CA9\u548C\u706B\u5C71\u788E\u5C51\u5F62\u6210\u7684\u5713\u9310\u72C0\u5730\u5F62\u3002\u64DA\u8AAA\u5728\u5442\u5B8B\u5CF6\u7684\u4E00\u5EA7\u5EE3\u95CA\u6E56\u6CCA\u4E2D\uFF0C\u96B1\u85CF\u8457\u4E00\u5EA7\u706B\u5C71\u9310\uFF0C\u5176\u56DB\u5468\u88AB\u6C34\u74B0\u7E5E\uFF0C\u8207\u6E56\u5FC3\u7684\u666F\u89C0\u878D\u70BA\u4E00\u9AD4\u3002\u5B83\u7684\u4F4D\u7F6E\u6697\u793A\u8457\u300C\u6E56\u4E2D\u4E4B\u5CF6\uFF0C\u5CF6\u4E2D\u4E4B\u6E56\u300D\uFF0C\u662F\u5927\u81EA\u7136\u7CBE\u5999\u8A2D\u8A08\u7684\u4E00\u90E8\u5206\u3002"
    image: {fileID: 21300000, guid: d11712affa643564398a42767431a9ac, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 8
    title: "\u5F27\u5F8C\u76C6\u5730"
    text: "\u5F27\u5F8C\u76C6\u5730\uFF08Back-Arc Basin\uFF09\u662F\u4E00\u7A2E\u4F4D\u65BC\u5CF6\u5F27\u80CC\u5F8C\u7684\u5730\u5F62\uFF0C\u7531\u677F\u584A\u4FEF\u885D\u4F5C\u7528\u5F15\u8D77\u7684\u5730\u6BBC\u62C9\u5F35\u548C\u5730\u5E54\u4E0A\u6E67\u5F62\u6210\uFF0C\u4F34\u96A8\u706B\u5C71\u6D3B\u52D5\u53CA\u6D77\u5E95\u64F4\u5F35\u73FE\u8C61\u3002\u5728\u7409\u7403\u5CF6\u5F27\uFF0C\u5F27\u5F8C\u76C6\u5730\u662F\u8A72\u5340\u57DF\u7279\u6709\u7684\u5730\u8CEA\u69CB\u9020\uFF0C\u4F8B\u5982\u6C96\u7E69\u6D77\u69FD\u5C31\u662F\u4E00\u500B\u5178\u578B\u7684\u5F27\u5F8C\u76C6\u5730\uFF0C\u5C55\u793A\u4E86\u677F\u584A\u4EA4\u754C\u7684\u52D5\u614B\u5730\u8CEA\u7279\u5FB5\u3002"
    image: {fileID: 21300000, guid: a2e0406bc3675be4dae0f6133bfe6616, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 9
    title: "\u5CFD\u8C37"
    text: "\u5CFD\u8C37\u5730\u5F62\uFF08Canyon\uFF09\u662F\u4E00\u7A2E\u6DF1\u9083\u72F9\u9577\u7684\u5730\u5F62\uFF0C\u7531\u6CB3\u6D41\u4FB5\u8755\u6216\u5730\u6BBC\u904B\u52D5\u4F5C\u7528\u5F62\u6210\uFF0C\u5E38\u4F34\u96A8\u9661\u5CED\u7684\u5CA9\u58C1\u548C\u58EF\u89C0\u7684\u5730\u8C8C\u7279\u5FB5\u3002\u5728\u53F0\u7063\uFF0C\u592A\u9B6F\u95A3\u5CFD\u8C37\u662F\u9019\u985E\u5730\u5F62\u7684\u5178\u578B\u4EE3\u8868\uFF0C\u7531\u7ACB\u9727\u6EAA\u9577\u671F\u4FB5\u8755\u7D50\u6676\u8CEA\u5927\u7406\u5CA9\u6240\u5F62\u6210\uFF0C\u5C55\u73FE\u4E86\u677F\u584A\u904B\u52D5\u8207\u6CB3\u6D41\u5730\u8C8C\u4EA4\u4E92\u4F5C\u7528\u7684\u5730\u8CEA\u5947\u89C0\u3002"
    image: {fileID: 21300000, guid: 0736223a7acd58f40a6562caf86eed16, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 10
    title: "\u9801\u5CA9"
    text: "\u9801\u5CA9\u662F\u4E00\u7A2E\u7D30\u7C92\u6C89\u7A4D\u5CA9\uFF0C\u5E38\u5448\u7070\u9ED1\u8272\uFF0C\u5177\u6709\u660E\u986F\u5C64\u7406\u7D50\u69CB\uFF0C\u5F62\u6210\u65BC\u6E56\u6CCA\u6216\u6DF1\u6D77\u7B49\u4F4E\u80FD\u74B0\u5883\u3002\u5728\u81FA\u7063\u5E38\u898B\u65BC\u897F\u90E8\u9E93\u5C71\u5E36\uFF0C\u5982\u77F3\u9580\u6C34\u5EAB\u9644\u8FD1\u53CA\u5357\u6295\u5730\u5340\uFF0C\u662F\u7814\u7A76\u5730\u8CEA\u6B77\u53F2\u7684\u91CD\u8981\u6750\u6599\u3002"
    image: {fileID: 21300000, guid: 7f45fa7d29351534bbaf65d440979d7d, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 11
    title: "\u7802\u5CA9"
    text: "\u7802\u5CA9\u7279\u6027 \u7531\u7802\u7C92\u81A0\u7D50\u800C\u6210\u7684\u6C89\u7A4D\u5CA9\u3002
      \u984F\u8272\u591A\u70BA\u6DFA\u68D5\u8272\u6216\u7070\u8272\u3002 \u8CEA\u5730\u70BA\u9846\u7C92\u72C0\u3002
      \u5F62\u6210\u65BC\u9AD8\u80FD\u74B0\u5883\uFF0C\u5982\u6CB3\u6D41\u3001\u6C99\u7058\u3002
      \u986F\u793A\u6C34\u6D41\u6C89\u7A4D\u7684\u7279\u5FB5\u3002 \u7802\u5CA9\u5728\u81FA\u7063\u7684\u5206\u5E03
      \u5E38\u898B\u65BC\u81FA\u7063\u897F\u90E8\u7684\u9E93\u5C71\u5E36\u3002 \u4EE3\u8868\u5730\u5340\uFF1A\u5927\u809A\u53F0\u5730\u3002
      \u7802\u5CA9\u7684\u5730\u8CEA\u610F\u7FA9 \u662F\u5730\u8CEA\u69CB\u9020\u7814\u7A76\u7684\u91CD\u8981\u6750\u6599"
    image: {fileID: 21300000, guid: 962e81a580163ba489fe5346b6365671, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 12
    title: "\u792B\u5CA9"
    text: "\u792B\u5CA9\u7531\u8F03\u5927\u7684\u5713\u5F62\u792B\u77F3\u8207\u7D30\u5C0F\u9846\u7C92\u81A0\u7D50\u800C\u6210\uFF0C\u5448\u591A\u5B54\u7D50\u69CB\uFF0C\u984F\u8272\u4F9D\u792B\u77F3\u6210\u5206\u800C\u7570\u3002\u5B83\u5F62\u6210\u65BC\u6CB3\u6D41\u6216\u5C71\u8C37\u7B49\u9AD8\u80FD\u74B0\u5883\uFF0C\u53CD\u6620\u5FEB\u901F\u6C89\u7A4D\u904E\u7A0B\u3002\u81FA\u7063\u792B\u5CA9\u5206\u5E03\u65BC\u82B1\u6771\u7E31\u8C37\u53CA\u90E8\u5206\u6CB3\u8C37\u5730\u5340\uFF0C\u662F\u5730\u8CEA\u6F14\u5316\u7684\u91CD\u8981\u898B\u8B49\u3002"
    image: {fileID: 21300000, guid: 23ac97834a8a2d1499e4e4830f47c963, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 13
    title: "\u82B1\u5CA1\u5CA9"
    text: "\u82B1\u5CA1\u5CA9\u7279\u6027 \u5C6C\u65BC\u6DF1\u6210\u5CA9\u548C\u9178\u6027\u706B\u6210\u5CA9\u3002
      \u4E3B\u8981\u7531\u77F3\u82F1\u3001\u9577\u77F3\u548C\u9ED1\u96F2\u6BCD\u7D44\u6210\u3002
      \u7D50\u6676\u7C92\u5F91\u7C97\u5927\uFF0C\u8CEA\u5730\u5805\u786C\u3002 \u82B1\u5CA1\u5CA9\u5728\u81FA\u7063\u7684\u5206\u5E03
      \u4E3B\u8981\u5206\u5E03\u65BC \u5916\u5CF6\u99AC\u7956\u8207\u82B1\u84EE\u548C\u5E73\u7B49\u5730\u5340\u3002"
    image: {fileID: 21300000, guid: 93dd9d487f0006c409a77bdb66ab07ba, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 14
    title: "\u5B89\u5C71\u5CA9"
    text: "\u5B89\u5C71\u5CA9\u7279\u6027 \u5C6C\u65BC\u706B\u5C71\u5674\u51FA\u5CA9\u548C\u4E2D\u6027\u706B\u6210\u5CA9\u3002
      \u4E3B\u8981\u7531\u659C\u9577\u77F3\u3001\u8F1D\u77F3\u548C\u89D2\u9583\u77F3\u7D44\u6210\u3002
      \u8CEA\u5730\u7D30\u7DFB\u6216\u5177\u6709\u6591\u6676\u69CB\u9020\u3002 \u5B89\u5C71\u5CA9\u5728\u81FA\u7063\u7684\u5206\u5E03
      \u5E38\u898B\u65BC\u5927\u5C6F\u706B\u5C71\u7FA4\u7B49\u706B\u5C71\u6D3B\u52D5\u5730\u5340\u3002"
    image: {fileID: 21300000, guid: d285279b62fbd1d47907c1fcaa68facb, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 15
    title: "\u7384\u6B66\u5CA9"
    text: "\u7384\u6B66\u5CA9\u7279\u6027 \u5C6C\u65BC\u706B\u5C71\u5674\u51FA\u5CA9\u548C\u57FA\u6027\u706B\u6210\u5CA9\u3002
      \u4E3B\u8981\u7531\u659C\u9577\u77F3\u548C\u8F1D\u77F3\u7D44\u6210\u3002 \u7D50\u6676\u7D30\u5C0F\uFF0C\u984F\u8272\u591A\u70BA\u9ED1\u8272\u6216\u6DF1\u7070\u8272\u3002
      \u7384\u6B66\u5CA9\u5728\u81FA\u7063\u7684\u5206\u5E03 \u5E38\u898B\u65BC\u6F8E\u6E56\u7FA4\u5CF6\u3002
      \u5176\u4ED6\u5206\u5E03\u5730\u5340\uFF1A\u6843\u5712\u89D2\u677F\u5C71\u7B49\u65E9\u671F\u706B\u5C71
      \u6D3B\u52D5\u5340\u57DF\u3002"
    image: {fileID: 21300000, guid: da122935460b21442995196017a6fdd1, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 16
    title: "\u5927\u7406\u77F3"
    text: "\u5927\u7406\u77F3\u7279\u6027 \u5C6C\u65BC\u63A5\u89F8\u8B8A\u8CEA\u5CA9\u3002
      \u7531\u77F3\u7070\u5CA9\u6216\u767D\u96F2\u5CA9\u5728\u9AD8\u6EAB\u9AD8\u58D3\u4E0B\u7D50\u6676\u5F62\u6210\u3002
      \u4E3B\u8981\u6210\u5206\u70BA\u65B9\u89E3\u77F3\u6216\u767D\u96F2\u77F3\u3002
      \u8CEA\u5730\u7DFB\u5BC6\u3001\u5177\u6709\u5149\u6FA4\u3002 \u5927\u7406\u77F3\u5728\u53F0\u7063\u7684\u5206\u5E03
      \u5E38\u898B\u65BC\u81FA\u7063\u6771\u90E8\u7684\u8B8A\u8CEA\u5E36"
    image: {fileID: 21300000, guid: 5cb7b41687371134d864421ac079f662, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 17
    title: "\u7247\u5CA9"
    text: "\u7247\u5CA9\u7279\u6027 \u5C6C\u65BC\u4E2D\u7B49\u8B8A\u8CEA\u5CA9\u3002
      \u7531\u6CE5\u8CEA\u5CA9\u7D93\u58D3\u529B\u8207\u6EAB\u5EA6\u4F5C\u7528\u5F62\u6210\u3002
      \u542B\u6709\u96F2\u6BCD\u3001\u77F3\u82F1\u7B49\u7926\u7269\u3002 \u8CEA\u5730\u5177\u6709\u7247\u72C0\u7D50\u69CB\u3002
      \u7247\u5CA9\u5728\u81FA\u7063\u7684\u5206\u5E03 \u5E38\u898B\u65BC\u96EA\u5C71\u5C71\u8108\u3002
      \u4EE3\u8868\u5730\u5340\uFF1A\u4E2D\u592E\u5C71\u8108\u3002"
    image: {fileID: 21300000, guid: 8d1b613aa0b84e34e8bf1a4cc06b9b40, type: 3}
    relatedTaskName: 
    Event:
      m_PersistentCalls:
        m_Calls: []
  - id: 18
    title: "\u7247\u9EBB\u5CA9"
    text: "\u7247\u9EBB\u5CA9\u7279\u6027 \u5C6C\u65BC\u9AD8\u7D1A\u8B8A\u8CEA\u5CA9\u3002
      \u7531\u6CE5\u8CEA\u5CA9\u6216\u82B1\u5D17\u5CA9\u5728\u9AD8\u58D3\u9AD8\u6EAB\u4E0B\u5F62\u6210\u3002
      \u5177\u6709\u689D\u5E36\u72C0\u69CB\u9020\u3002 \u542B\u6709\u77F3\u82F1\u3001\u9577\u77F3\u3001\u9ED1\u96F2\u6BCD\u7B49\u7926\u7269\u3002
      \u7247\u9EBB\u5CA9\u5728\u81FA\u7063\u7684\u5206\u5E03 \u5E38\u898B\u65BC\u4E2D\u592E\u5C71\u8108\u3002"
    image: {fileID: 21300000, guid: 178d8f928a1608c4bb9926ca3b34faf9, type: 3}
    relatedTaskName: 
