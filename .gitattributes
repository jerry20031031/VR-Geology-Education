# Normalize text files
* text=auto

# Unity text assets should stay mergeable
*.asmdef text
*.asmref text
*.asset text
*.controller text
*.mat text
*.meta text
*.overrideController text
*.playable text
*.prefab text
*.renderTexture text
*.unity text

# Large/binary Unity assets use Git LFS
*.3ds filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
*.aab filter=lfs diff=lfs merge=lfs -text
